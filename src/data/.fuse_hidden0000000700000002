// ----- Helpers ---------------------------------------------------------------
export const exercisesForLocation = (loc) => {
  const owned = new Set(EQUIPMENT[loc] || EQUIPMENT.home)
  return EXERCISES.filter((e) => e.equip.every((q) => owned.has(q)))
}

export const exerciseById = (id) => EXERCISES.find((e) => e.id === id)

